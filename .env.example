# Copy to .env and adjust. .env is git-ignored: no password is ever committed.
# Oracle requires passwords with 8+ characters; use only letters, digits and . _ - (no quotes/spaces).

ORACLE_PASSWORD=ChangeMe_123456
WALLET_OWNER_PASSWORD=WalletOwner_123456
WALLET_AUDIT_PASSWORD=WalletAudit_123456
WALLET_APP_PASSWORD=WalletApp_123456

# Comma separated list of accepted X-API-Key values.
WALLET_API_KEYS=local-dev-key
